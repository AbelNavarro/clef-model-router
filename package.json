{
  "name": "clef-model-router",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code mod: picks the Claude model and reasoning effort for each turn with Cloudflare Clef.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test 'test/**/*.spec.ts'",
    "test:mod": "claude plugin test .",
    "types": "node scripts/fetch-types.ts",
    "typecheck": "tsc -p tsconfig.node.json",
    "validate": "claude plugin validate .",
    "check": "npm run typecheck && npm run typecheck:mod && npm test && npm run validate && npm run test:mod",
    "calibrate": "node scripts/calibrate.ts",
    "smoke": "node scripts/smoke.ts",
    "typecheck:mod": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
